---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ArchWindow from '../components/ArchWindow.astro';
import Wave from '../components/Wave.astro';
import { contact, mailto, pricing, deliversTo } from '../config';

const tiers = [...pricing].reverse();

const care = [
  {
    title: 'It never clears customs',
    body: 'Everything ordered from home crosses a border, and the one person who can chase it is in another country. Ours is made twenty minutes from where you will be standing.',
  },
  {
    title: 'Your count can move',
    body: 'Cousins book late and someone always drops out. Tell us the final number ten days before the wedding; anything unused comes back to us rather than onto your bill.',
  },
  {
    title: 'It is waiting when they land',
    body: 'Delivered to your resort three days ahead, assembled, with a signed receipt. The staff place them in the rooms before your guests arrive, and nothing at all travels in your suitcase.',
  },
];

const contents = [
  { n: 'I', label: 'What we make', href: '#bag' },
  { n: 'II', label: 'What we take off your hands', href: '#care' },
  { n: 'III', label: 'What it costs', href: '#price' },
  { n: 'IV', label: 'How to begin', href: '#write' },
];
---

<Base>
  <Nav />

  <!-- ── I. Hero ─────────────────────────────────────────────── -->
  <section class="act hero">
    <div class="hero__grid">
      <div class="hero__text">
        <span class="cap rise" style="animation-delay:.05s">Welcome bags · Riviera Maya</span>
        <h1 class="rise" style="animation-delay:.14s">
          Something lovely, <i>already</i> in the room.
        </h1>
        <p class="hero__lede rise" style="animation-delay:.26s">
          One welcome bag, made by hand in Puerto Morelos and carried to your resort
          three days before you marry. It never crosses a border, and you never carry
          a thing.
        </p>
        <div class="hero__cta rise" style="animation-delay:.36s">
          <a href={mailto} class="btn">Write to us</a>
          <span class="hero__note">A drawing of your bag comes back the same day</span>
        </div>
      </div>
      <div class="rise" style="animation-delay:.2s"><ArchWindow /></div>
    </div>
  </section>

  <!-- ── Contents ────────────────────────────────────────────── -->
  <section class="act contents">
    <hr class="rule" />
    <ol class="contents__list">
      {
        contents.map((item) => (
          <li>
            <a href={item.href}>
              <span class="num">{item.n}</span>
              <span class="contents__label">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ── II. The bag ─────────────────────────────────────────── -->
  <section id="bag" class="bag">
    <div class="bag__grid">
      <figure class="bag__shot">
        <figcaption class="cap">Photograph — the bag, on the bed, at check-in</figcaption>
      </figure>
      <div class="bag__text">
        <div class="eyebrow"><span class="num">I</span><span class="cap">What we make</span></div>
        <h2>The welcome bag. Nothing else.</h2>
        <p class="drop">
          A cotton tote carrying your names and your date, and inside it the weekend
          printed on a card, two bottle labels and a luggage tag. Every piece is cut
          and printed by the two of us, for your wedding and no one else's.
        </p>
        <p>
          There is no catalogue and there are no packages with silly names. We take one
          wedding a week, and when a week is taken we say so early rather than take the
          order and hope.
        </p>
        <ul class="bag__pills">
          <li class="cap pill">Your names</li>
          <li class="cap pill">Your date</li>
          <li class="cap pill">Your colours</li>
          <li class="cap pill">Assembled &amp; delivered</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Pull quote ──────────────────────────────────────────── -->
  <section class="quote">
    <div class="act quote__inner">
      <Wave />
      <h2><i>One wedding a week</i> — so yours is the only one on the table.</h2>
      <p>
        Two sisters, one room in Puerto Morelos, twenty minutes from most of the
        resorts on this coast.
      </p>
    </div>
  </section>

  <!-- ── III. What we take off your hands ────────────────────── -->
  <section id="care" class="act care">
    <div class="eyebrow">
      <span class="num">II</span><span class="cap">What we take off your hands</span>
    </div>
    <dl class="care__list">
      {
        care.map((item) => (
          <div class="care__row">
            <dt><h3>{item.title}</h3></dt>
            <dd>{item.body}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- ── IV. Price ───────────────────────────────────────────── -->
  <section id="price" class="act price">
    <div class="price__text">
      <div class="eyebrow"><span class="num">III</span><span class="cap">What it costs</span></div>
      <h2>Published, so you needn't ask.</h2>
      <p>
        Delivery to your resort is included, there is no minimum and no setup fee. It
        eases as the order grows, because drawing it and driving it out cost the same
        for twelve bags or for sixty.
      </p>
      <p class="price__where">
        {`We deliver to ${deliversTo.slice(0, -1).join(', ')} and ${deliversTo.at(-1)} — and we do not ship anywhere at all.`}
      </p>
    </div>
    <div class="price__table">
      {
        tiers.map((tier) => (
          <div class="price__row">
            <span class="cap price__band">{tier.label}</span>
            <span class="price__figure">${tier.price}</span>
          </div>
        ))
      }
      <span class="cap price__foot">
        USD per bag, delivered · half holds your date, the rest on handover
      </span>
    </div>
  </section>

  <!-- ── V. The letter ───────────────────────────────────────── -->
  <section id="write" class="write">
    <svg class="write__branch" width="360" height="440" viewBox="0 0 360 440" aria-hidden="true">
      <g stroke="#c98a4b" stroke-width="1.1" fill="none" stroke-linecap="round">
        <path d="M186 440 C176 350 168 274 156 210"></path>
        <path d="M158 232 C124 216 106 184 114 152 C150 158 170 190 166 224"></path>
        <path d="M170 286 C206 272 226 244 222 214 C188 216 168 248 168 280"></path>
        <path d="M176 344 C142 330 124 298 132 266 C168 272 186 304 182 338"></path>
        <path d="M186 392 C222 378 242 350 238 320 C204 322 184 354 184 386"></path>
      </g>
    </svg>

    <div class="act write__grid">
      <div class="write__text">
        <div class="eyebrow">
          <span class="num">IV</span><span class="cap write__cap">How to begin</span>
        </div>
        <h2>Tell us the date. We will draw the bag.</h2>
        <p>
          You will have a picture of your own bag — your names, your date, your colours
          — the same day, at no cost, and yours to keep even if you go elsewhere. No
          form, no call, no sequence of emails afterwards.
        </p>
        <a href={mailto} class="btn btn--light">Write to us</a>
        <a class="write__mail" href={mailto}>{contact.email}</a>
      </div>

      <div class="letter">
        <div class="letter__head">
          <span class="cap">Copy this, if it helps</span>
          <Wave width={34} />
        </div>
        <div class="letter__to">
          <span class="cap">To</span>
          <span class="letter__addr">{contact.email}</span>
        </div>
        <p class="letter__body">
          Hello — we're marrying at <span class="blank">[venue]</span> on <span class="blank">[date]</span> and would like about <span class="blank">[number]</span> welcome bags. Our colours are <span class="blank">[colours]</span>. Could you send us a drawing?
        </p>
        <div class="letter__foot">
          <span>That is the whole first email.</span>
          <span class="letter__sign">— the sisters</span>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Base>

<style>
  .eyebrow {
    display: flex;
    align-items: baseline;
    gap: 18px;
  }

  /* ── hero ─────────────────────────────────────────────────── */
  .hero {
    padding-top: 76px;
    padding-bottom: 64px;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.22fr) minmax(0, 0.78fr);
    gap: 76px;
    align-items: end;
  }
  .hero__text {
    display: flex;
    flex-direction: column;
    gap: 38px;
  }
  .hero h1 {
    font-size: clamp(52px, 7.4vw, 112px);
    max-width: 12ch;
  }
  .hero h1 i {
    color: var(--sea);
  }
  .hero__lede {
    font-size: 21px;
    color: var(--muted);
    line-height: 1.7;
  }
  .hero__cta {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }
  .hero__note {
    font-size: 16.5px;
    color: var(--quiet);
  }

  /* ── contents ─────────────────────────────────────────────── */
  .contents {
    padding-top: 26px;
    padding-bottom: var(--section);
  }
  .contents__list {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 36px;
  }
  .contents__list a {
    display: flex;
    gap: 16px;
    align-items: baseline;
    color: var(--muted);
  }
  .contents__label {
    font-size: 17px;
  }

  /* ── the bag ──────────────────────────────────────────────── */
  .bag {
    padding-bottom: var(--section);
  }
  .bag__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 90px;
    align-items: center;
  }
  /* deliberately breaks the left margin — the page is otherwise too even */
  .bag__shot {
    margin: 0;
    height: 640px;
    background: var(--mist);
    border-radius: 0 999px 18px 0;
    display: flex;
    align-items: flex-end;
    padding: 30px;
  }
  .bag__text {
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding-right: var(--gutter);
  }
  .bag h2 {
    font-size: clamp(40px, 4.6vw, 68px);
    max-width: 13ch;
  }
  .bag p {
    font-size: 19px;
    color: var(--muted);
    line-height: 1.85;
  }
  .bag__pills {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ── pull quote ───────────────────────────────────────────── */
  .quote {
    background: var(--sand);
  }
  .quote__inner {
    padding-top: 104px;
    padding-bottom: 104px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 30px;
  }
  .quote h2 {
    font-size: clamp(34px, 4.2vw, 60px);
    max-width: 22ch;
    line-height: 1.12;
  }
  .quote p {
    font-size: 18.5px;
    color: #6e7b75;
    max-width: 52ch;
  }

  /* ── care ─────────────────────────────────────────────────── */
  .care {
    padding-top: var(--section);
    padding-bottom: var(--section);
    display: flex;
    flex-direction: column;
    gap: 60px;
  }
  .care__list {
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .care__row {
    display: grid;
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
    gap: 80px;
    border-top: 1px solid var(--rule);
    padding: 40px 0;
  }
  .care__row:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .care__row dt {
    margin: 0;
  }
  .care__row h3 {
    font-size: clamp(27px, 2.6vw, 34px);
    line-height: 1.2;
  }
  .care__row dd {
    margin: 0;
    font-size: 19px;
    color: var(--muted);
    max-width: 62ch;
    line-height: 1.8;
  }

  /* ── price ────────────────────────────────────────────────── */
  .price {
    padding-bottom: 130px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: 100px;
    align-items: start;
  }
  .price__text {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .price h2 {
    font-size: clamp(36px, 4vw, 58px);
    max-width: 15ch;
  }
  .price p {
    font-size: 19px;
    color: var(--muted);
    line-height: 1.85;
  }
  .price__where {
    color: var(--quiet);
  }
  .price__table {
    display: flex;
    flex-direction: column;
  }
  .price__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    border-top: 1px solid var(--rule);
    padding: 22px 0;
  }
  .price__row:last-of-type {
    border-bottom: 1px solid var(--rule);
  }
  .price__band {
    color: #6e7b75;
  }
  .price__figure {
    font-family: var(--serif);
    font-size: 42px;
  }
  .price__foot {
    padding-top: 18px;
  }

  /* ── the letter ───────────────────────────────────────────── */
  .write {
    background: var(--ink);
    color: #dce3df;
    position: relative;
    overflow: hidden;
  }
  .write__branch {
    position: absolute;
    left: -60px;
    bottom: -40px;
    opacity: 0.22;
  }
  .write__grid {
    padding-top: 130px;
    padding-bottom: 130px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 90px;
    align-items: center;
    position: relative;
  }
  .write__text {
    display: flex;
    flex-direction: column;
    gap: 30px;
    align-items: flex-start;
  }
  .write__cap {
    color: #7e8c86;
  }
  .write h2 {
    font-size: clamp(40px, 5.2vw, 74px);
    color: #f4f1ea;
    max-width: 13ch;
  }
  .write p {
    font-size: 20px;
    color: #9eaaa4;
    line-height: 1.85;
  }
  .write__mail {
    font-family: var(--serif);
    font-size: 32px;
    color: var(--ochre);
    word-break: break-word;
  }

  .letter {
    background: var(--paper);
    color: var(--ink);
    padding: 52px 56px;
    transform: rotate(-0.9deg);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.28);
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .letter__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 18px;
  }
  .letter__to {
    display: flex;
    gap: 16px;
    align-items: baseline;
    font-size: 16.5px;
  }
  .letter__addr {
    color: var(--sea);
    word-break: break-word;
  }
  .letter__body {
    font-size: 19px;
    color: #3b4a45;
    line-height: 2.05;
    max-width: none;
  }
  .blank {
    border-bottom: 1.5px solid var(--ochre);
    padding-bottom: 2px;
  }
  .letter__foot {
    border-top: 1px solid var(--rule);
    padding-top: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    font-size: 16px;
    color: var(--quiet);
  }
  .letter__sign {
    font-family: var(--serif);
    font-style: italic;
    font-size: 23px;
    color: var(--sea);
  }

  /* ── responsive ───────────────────────────────────────────── */
  @media (max-width: 1180px) {
    .hero__grid,
    .bag__grid,
    .write__grid {
      gap: 52px;
    }
    .care__row {
      gap: 44px;
    }
    .price {
      gap: 56px;
    }
    .bag__shot {
      height: 520px;
    }
  }

  @media (max-width: 980px) {
    .contents__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px 36px;
    }
  }

  @media (max-width: 860px) {
    .hero {
      padding-top: 34px;
      padding-bottom: 40px;
    }
    .hero__grid,
    .bag__grid,
    .price,
    .write__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero__text {
      gap: 26px;
    }
    .hero__lede {
      font-size: 18.5px;
    }
    .hero__cta {
      gap: 14px;
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }
    .contents__list {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }
    .bag__shot {
      height: 380px;
      border-radius: 0 260px 18px 0;
      padding: 20px;
    }
    .bag__text {
      padding-right: 0;
    }
    .bag p {
      font-size: 17.5px;
    }
    .quote__inner {
      padding-top: 64px;
      padding-bottom: 64px;
      gap: 22px;
    }
    .care {
      gap: 34px;
    }
    .care__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
      padding: 28px 0;
    }
    .care__row dd {
      font-size: 17.5px;
    }
    .price {
      padding-bottom: 64px;
    }
    .price p {
      font-size: 17.5px;
    }
    .price__figure {
      font-size: 34px;
    }
    .write__grid {
      padding-top: 64px;
      padding-bottom: 64px;
      gap: 40px;
    }
    .write p {
      font-size: 18px;
    }
    .write__mail {
      font-size: 24px;
    }
    .write__branch {
      display: none;
    }
    .letter {
      padding: 30px 26px;
      transform: none;
    }
    .letter__body {
      font-size: 17.5px;
      line-height: 1.95;
    }
    .letter__foot {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
</style>
