---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Shot from '../components/Shot.astro';
import toteBeach from '../assets/tote-beach.jpg';
import totePalm from '../assets/tote-palm.jpg';
import toteFlat from '../assets/tote-flat.jpg';
import toteInside from '../assets/tote-inside.jpg';
import totePrint from '../assets/tote-print.jpg';
import Wave from '../components/Wave.astro';
import PriceEstimator from '../components/PriceEstimator.astro';
import { contact, mailto, deliversTo } from '../config';

const care = [
  {
    title: 'It never clears customs',
    body: 'Everything ordered from home crosses a border, and the one person who can chase it is in another country. Ours is made twenty minutes from where you will be standing.',
  },
  {
    title: 'Your count can move',
    body: 'Cousins book late and someone always drops out. Tell us the final number ten days before the wedding; anything unused comes back to us rather than onto your bill.',
  },
  {
    title: 'It is waiting when they land',
    body: 'Delivered to your resort three days ahead, assembled, with a signed receipt. The staff place them in the rooms before your guests arrive, and nothing at all travels in your suitcase.',
  },
];

const deliveryLine = `We deliver to ${deliversTo
  .slice(0, -1)
  .join(', ')} and ${deliversTo.at(-1)} — and we do not ship anywhere at all.`;
---

<Base>
  <Nav />

  <!-- ── I. Hero ─────────────────────────────────────────────── -->
  <section class="section hero">
    <div class="container hero__grid">
      <div class="hero__text">
        <span class="cap rise" style="animation-delay:.05s">Welcome bags · Riviera Maya</span>
        <h1 class="rise" style="animation-delay:.14s">
          Something lovely, <i>already</i> in the room.
        </h1>
        <p class="hero__lede rise" style="animation-delay:.26s">
          One welcome bag, made by hand in Puerto Morelos and carried to your resort
          three days before you marry. It never crosses a border, and you never carry
          a thing.
        </p>
        <div class="hero__cta rise" style="animation-delay:.36s">
          <a href={mailto} class="btn">Write to us</a>
          <span class="hero__note">A drawing of your bag comes back the same day</span>
        </div>
      </div>
      <div class="hero__window rise" style="animation-delay:.2s">
        <Shot
          class="arch"
          src={toteBeach}
          alt="A cotton welcome tote printed with a couple's names, standing on the sand at sunset"
          eager
        />
      </div>
    </div>
  </section>

  <!-- ── II. The bag ─────────────────────────────────────────── -->
  <section id="bag" class="section bag">
    <div class="bleed bag__grid">
      <Shot
        class="arch bag__shot"
        src={totePalm}
        alt="A printed cotton welcome tote hanging by a palm on the beach in the Riviera Maya"
        widths={[372]}
      />
      <div class="bag__text">
        <h2>The welcome bag. Nothing else.</h2>
        <p>
          A cotton tote carrying your names and your date, and inside it the weekend
          printed on a card, two bottle labels and a luggage tag. Every piece is cut
          and printed by the two of us, for your wedding and no one else's.
        </p>
        <p>
          There is no catalogue and there are no packages with silly names. We take one
          wedding a week, and when a week is taken we say so early rather than take the
          order and hope.
        </p>
        <ul class="bag__pills">
          <li class="cap pill">Your names</li>
          <li class="cap pill">Your date</li>
          <li class="cap pill">Your colours</li>
          <li class="cap pill">Assembled &amp; delivered</li>
        </ul>
      </div>
    </div>

    <div class="container bag__gallery">
      <figure class="bag__plate">
        <Shot src={toteFlat} alt="The printed tote laid flat on a woven mat with eucalyptus" widths={[352]} sizes="(min-width: 900px) 30vw, 100vw" />
        <figcaption class="cap">Pressed by hand, in one or two inks</figcaption>
      </figure>
      <figure class="bag__plate">
        <Shot src={toteInside} alt="Looking into the open tote — unlined cotton canvas with reinforced handles" widths={[352]} sizes="(min-width: 900px) 30vw, 100vw" />
        <figcaption class="cap">Room for the weekend, and for the flight home</figcaption>
      </figure>
      <figure class="bag__plate">
        <Shot src={totePrint} alt="Close up of the printing on the canvas: names, date and town" widths={[352]} sizes="(min-width: 900px) 30vw, 100vw" />
        <figcaption class="cap">Your names, your date, the town</figcaption>
      </figure>
    </div>
  </section>

  <!-- ── Pull quote ──────────────────────────────────────────── -->
  <section class="section quote">
    <div class="container quote__inner">
      <Wave />
      <h2><i>One wedding a week</i> — so yours is the only one on the table.</h2>
      <p>
        Two sisters, one room in Puerto Morelos, twenty minutes from most of the
        resorts on this coast.
      </p>
    </div>
  </section>

  <!-- ── III. What we take off your hands ────────────────────── -->
  <section id="care" class="section care">
    <div class="container">
      <dl class="care__list">
        {
          care.map((item) => (
            <div class="care__row">
              <dt><h3>{item.title}</h3></dt>
              <dd>{item.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ── IV. Price ───────────────────────────────────────────── -->
  <section id="price" class="section price">
    <div class="container price__grid">
      <div class="price__text">
        <h2>Published, so you needn't ask.</h2>
        <p>
          The price eases as the order grows, because drawing it and driving it out
          cost the same for twelve bags or for sixty. There is no minimum and no
          setup fee.
        </p>
        <p class="price__where">{deliveryLine}</p>
      </div>
      <PriceEstimator />
    </div>
  </section>

  <!-- ── V. The letter ───────────────────────────────────────── -->
  <section id="write" class="section write">
    <svg class="write__branch" width="360" height="440" viewBox="0 0 360 440" aria-hidden="true">
      <g stroke="#c98a4b" stroke-width="1.1" fill="none" stroke-linecap="round">
        <path d="M186 440 C176 350 168 274 156 210"></path>
        <path d="M158 232 C124 216 106 184 114 152 C150 158 170 190 166 224"></path>
        <path d="M170 286 C206 272 226 244 222 214 C188 216 168 248 168 280"></path>
        <path d="M176 344 C142 330 124 298 132 266 C168 272 186 304 182 338"></path>
        <path d="M186 392 C222 378 242 350 238 320 C204 322 184 354 184 386"></path>
      </g>
    </svg>

    <div class="container write__grid">
      <div class="write__text">
        <h2>Tell us the date. We will draw the bag.</h2>
        <p>
          You will have a picture of your own bag — your names, your date, your colours
          — the same day, at no cost, and yours to keep even if you go elsewhere. No
          form, no call, no sequence of emails afterwards.
        </p>
        <a href={mailto} class="btn btn--light">Write to us</a>
        <a class="write__mail" href={mailto}>{contact.email}</a>
      </div>

      <div class="letter">
        <div class="letter__head">
          <span class="cap">Copy this, if it helps</span>
          <Wave width={34} />
        </div>
        <div class="letter__to">
          <span class="cap">To</span>
          <span class="letter__addr">{contact.email}</span>
        </div>
        <p class="letter__body">
          Hello — we're marrying at <span class="blank">[venue]</span> on <span class="blank">[date]</span> and would like about <span class="blank">[number]</span> welcome bags. Our colours are <span class="blank">[colours]</span>. Could you send us a drawing?
        </p>
        <div class="letter__foot">
          <span>That is the whole first email.</span>
          <span class="letter__sign">— the sisters</span>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Base>

<style>
  /* Sections own vertical rhythm; containers own the gutter. Nothing below
     sets a height, and the breakpoints reassign properties rather than
     restating rules. */

  /* ── hero ─────────────────────────────────────────────────── */
  .hero__window :global(.shot) {
    --well-ratio: var(--ratio-window);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-2xl);
    align-items: end;
  }
  .hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-lg);
  }
  .hero h1 {
    font-size: clamp(46px, 7.4vw, 112px);
    max-width: 12ch;
  }
  .hero h1 i {
    color: var(--c-sea);
  }
  .hero__lede {
    font-size: 18.5px;
    color: var(--c-body);
    line-height: 1.7;
  }
  .hero__cta {
    display: flex;
    flex-direction: column;
    gap: var(--sp-xs);
    text-align: center;
  }
  .hero__note {
    font-size: 16px;
    color: var(--c-quiet);
  }


  /* ── the bag ──────────────────────────────────────────────── */
  .bag__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-2xl);
    align-items: center;
  }
  /* The arch escapes the gutter on the left on purpose — the page is
     otherwise too even. It keeps its own ratio, never a height. */
  .bag__shot {
    --well-ratio: 1 / 1;
    background: var(--c-mist);
    border-radius: 0 260px 18px 0;
    margin-right: var(--container-pad);
  }
  .bag__text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
    padding-inline: var(--container-pad);
  }
  .bag h2 {
    font-size: clamp(36px, 4.6vw, 68px);
    max-width: 13ch;
  }
  .bag p {
    font-size: 17.5px;
    color: var(--c-body);
    line-height: 1.85;
  }
  .bag__pills {
    display: flex;
    gap: var(--sp-2xs);
    flex-wrap: wrap;
    margin-top: var(--sp-3xs);
  }

  /* Three plates at their native size — the sources are ~360px, so the row is
     sized to match rather than blow them up. Ratios differ on purpose: an even
     grid of squares reads like a contact sheet. */
  .bag__gallery {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-md);
    align-items: end;
  }
  .bag__plate {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2xs);
    margin: 0;
  }
  .bag__plate :global(.shot) {
    --well-ratio: 1 / 1;
    border-radius: 999px 999px 14px 14px;
  }
  .bag__plate:first-child :global(.shot) {
    --well-ratio: 8 / 9;
  }

  /* ── pull quote ───────────────────────────────────────────── */
  .quote {
    background: var(--c-sand);
    width: 100%;
  }
  .quote__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--sp-md);
  }
  .quote h2 {
    font-size: clamp(32px, 4.2vw, 60px);
    max-width: 22ch;
    line-height: 1.12;
  }
  .quote p {
    font-size: 18px;
    color: #6e7b75;
    max-width: 52ch;
  }

  /* ── care ─────────────────────────────────────────────────── */
  .care__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-2xs);
    border-top: var(--stroke-hair) solid var(--c-rule);
    padding-block: var(--sp-lg);
  }
  .care__row:last-child {
    border-bottom: var(--stroke-hair) solid var(--c-rule);
  }
  .care__row h3 {
    font-size: clamp(26px, 2.6vw, 34px);
    line-height: 1.2;
  }
  .care__row dd {
    font-size: 17.5px;
    color: var(--c-body);
    max-width: 62ch;
    line-height: 1.8;
  }

  /* ── price ────────────────────────────────────────────────── */
  .price__grid {
    display: flex;
    flex-direction: column;
    gap: var(--sp-lg);
  }
  .price__text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
  }
  .price h2 {
    font-size: clamp(34px, 4vw, 58px);
    max-width: 16ch;
  }
  .price p {
    font-size: 17.5px;
    color: var(--c-body);
    line-height: 1.85;
  }
  .price__where {
    color: var(--c-quiet);
  }

  /* ── the letter ───────────────────────────────────────────── */
  .write {
    background: var(--c-ink);
    color: var(--c-ink-fg);
    width: 100%;
    overflow: hidden;
  }
  .write__branch {
    position: absolute;
    left: -60px;
    bottom: -40px;
    opacity: 0.22;
    display: none;
  }
  .write__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-2xl);
    align-items: center;
    position: relative;
  }
  .write__text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
    align-items: flex-start;
  }
  .write h2 {
    font-size: clamp(38px, 5.2vw, 74px);
    color: var(--c-ink-head);
    max-width: 13ch;
  }
  .write p {
    font-size: 18px;
    color: var(--c-ink-body);
    line-height: 1.85;
  }
  .write__mail {
    font-size: 18px;
    letter-spacing: 0.01em;
    color: var(--c-ochre);
    word-break: break-word;
    border-bottom: var(--stroke-hair) solid rgb(201 138 75 / 0.5);
    padding-bottom: 3px;
  }

  .letter {
    background: var(--c-paper);
    color: var(--c-ink);
    padding: var(--sp-lg) var(--sp-md);
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
  }
  .letter__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: var(--stroke-hair) solid var(--c-rule);
    padding-bottom: var(--sp-sm);
  }
  .letter__to {
    display: flex;
    gap: var(--sp-xs);
    align-items: baseline;
    font-size: 16.5px;
  }
  .letter__addr {
    color: var(--c-sea);
    word-break: break-word;
  }
  .letter__body {
    font-size: 17.5px;
    color: #3b4a45;
    line-height: 1.95;
    max-width: none;
  }
  .blank {
    border-bottom: var(--stroke-blank) solid var(--c-ochre);
    padding-bottom: 2px;
  }
  .letter__foot {
    border-top: var(--stroke-hair) solid var(--c-rule);
    padding-top: var(--sp-sm);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3xs);
    font-size: 16px;
    color: var(--c-quiet);
  }
  .letter__sign {
    font-family: var(--f-display);
    font-style: italic;
    font-size: 23px;
    color: var(--c-sea);
  }

  /* ── from here the layout has room: two columns, and a few
        properties reassigned. No rule is restated. ──────────── */

  @media (min-width: 700px) {
    .hero__cta {
      flex-direction: row;
      align-items: center;
      gap: var(--sp-lg);
      text-align: left;
    }
    .letter {
      padding: var(--sp-2xl) var(--sp-3xl);
    }
    .letter__foot {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.22fr) minmax(0, 0.78fr);
      gap: var(--sp-3xl);
    }
    .hero__lede {
      font-size: 21px;
    }
    .bag__grid {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
      gap: var(--sp-3xl);
      align-items: center;
    }
    .bag__shot {
      --well-ratio: 1 / 1;
      border-radius: 0 999px 18px 0;
      margin-right: 0;
    }
    .bag__text {
      padding-left: 0;
    }
    .bag p,
    .care__row dd,
    .price p {
      font-size: 19px;
    }
    .bag__gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--sp-lg);
    }
    .care__row {
      grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
      gap: var(--sp-3xl);
      padding-block: var(--sp-xl);
    }
    .write__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      gap: var(--sp-3xl);
    }
    .price__grid {
      gap: var(--sp-xl);
    }
    .price__text {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: var(--sp-3xl);
      align-items: end;
    }
    .price__where {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: end;
    }
      .write__branch {
      display: block;
    }
    .write p {
      font-size: 20px;
    }
    .write__mail {
      font-size: 20px;
    }
    .letter {
      box-shadow: 0 24px 60px rgb(0 0 0 / 0.22);
    }
    .letter__body {
      font-size: 19px;
      line-height: 2.05;
    }
  }

  @media (min-width: 1280px) {
    .write__grid {
      gap: var(--sp-4xl);
    }
    .bag__grid {
      gap: var(--sp-4xl);
    }
  }
</style>
