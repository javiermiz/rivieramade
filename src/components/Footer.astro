---
import { deliversTo, contact, instagramUrl } from '../config';
---
<footer class="section foot">
  <div class="container foot__bar">
    <span class="foot__word">riviera made</span>
    <span class="cap foot__area">{deliversTo.join(' · ')}</span>
    <a class="cap foot__mail" href={`mailto:${contact.email}`}>{contact.email}</a>
    <a class="cap foot__social" href={instagramUrl} rel="me">@{contact.instagram}</a>
    <a class="cap foot__trade" href="/faq">Questions</a>
    <a class="cap foot__trade" href="/venues">Venues</a>
    <a class="cap foot__trade" href="/planners">For wedding planners</a>
    <a class="cap foot__fine" href="/terms">Terms</a>
    <a class="cap foot__fine" href="/privacy">Privacy</a>
  </div>
</footer>

<style>
  .foot { padding-block: var(--sp-2xl); }
  .foot__bar {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-2xs);
  }
  .foot__word {
    font-size: 15px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .foot__mail { color: var(--c-ochre); }
  .foot__social { color: var(--c-ochre); }
  .foot__trade { color: var(--c-quiet); }
  .foot__fine { color: var(--c-faint); }

  @media (min-width: 980px) {
    .foot__bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--sp-3xl);
    }
  }
</style>
