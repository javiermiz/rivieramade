---
import { deliversTo, contact } from '../config';
---
<footer class="section foot">
  <div class="container foot__bar">
    <span class="foot__word">riviera made</span>
    <span class="cap foot__area">{deliversTo.join(' · ')}</span>
    <a class="cap foot__mail" href={`mailto:${contact.email}`}>{contact.email}</a>
  </div>
</footer>

<style>
  .foot { padding-block: var(--sp-2xl); }
  .foot__bar {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-2xs);
  }
  .foot__word {
    font-size: 15px;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .foot__mail { color: var(--c-ochre); }

  @media (min-width: 980px) {
    .foot__bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--sp-3xl);
    }
  }
</style>
