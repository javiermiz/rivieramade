---
import { mailto } from '../config';
---
<nav class="act nav">
  <a href="/" class="nav__mark" aria-label="Riviera Made — home">
    <svg width="30" height="30" viewBox="0 0 40 40" aria-hidden="true">
      <circle cx="20" cy="20" r="18.2" fill="none" stroke="var(--ochre)" stroke-width=".9"></circle>
      <path d="M7 25.5 C12 21.6 16.4 27 21.4 23 C25.2 19.9 28.6 22 33 20.6"
        stroke="var(--sea)" stroke-width="1.1" fill="none" stroke-linecap="round"></path>
      <circle cx="20" cy="13.4" r="3.6" fill="var(--ochre)"></circle>
    </svg>
    <span class="nav__word">riviera made</span>
  </a>
  <div class="nav__links">
    <a class="cap nav__link" href="#bag">The bag</a>
    <a class="cap nav__link" href="#price">Price</a>
    <a class="cap nav__link nav__link--cta" href={mailto}>Write to us</a>
  </div>
</nav>
<div class="act"><hr class="rule" /></div>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 38px;
    padding-bottom: 34px;
    gap: 24px;
  }
  .nav__mark {
    display: flex;
    align-items: center;
    gap: 15px;
    color: var(--ink);
  }
  .nav__mark:hover { color: var(--ink); }
  .nav__word {
    font-size: 16px;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .nav__links { display: flex; align-items: center; gap: 44px; }
  .nav__link { color: var(--ink); }
  .nav__link--cta {
    border-bottom: 1px solid var(--ochre);
    padding-bottom: 5px;
  }
  @media (max-width: 860px) {
    .nav { padding-top: 24px; padding-bottom: 22px; }
    .nav__word { font-size: 13px; letter-spacing: 0.3em; }
    .nav__links { gap: 20px; }
    .nav__link:not(.nav__link--cta) { display: none; }
  }
</style>
