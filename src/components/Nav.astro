---
import { mailto } from '../config';
---
<header class="nav">
  <div class="container nav__bar">
    <a href="/" class="nav__mark" aria-label="Riviera Made — home">
      <svg width="30" height="30" viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="20" r="18.2" fill="none" stroke="var(--c-ochre)" stroke-width=".9"></circle>
        <path d="M7 25.5 C12 21.6 16.4 27 21.4 23 C25.2 19.9 28.6 22 33 20.6"
          stroke="var(--c-sea)" stroke-width="1.1" fill="none" stroke-linecap="round"></path>
        <circle cx="20" cy="13.4" r="3.6" fill="var(--c-ochre)"></circle>
      </svg>
      <span class="nav__word">riviera made</span>
    </a>
    <nav class="nav__links">
      <a class="cap nav__link" href="/#bag">The bag</a>
      <a class="cap nav__link" href="/#price">Price</a>
      <a class="cap nav__link" href="/faq">Questions</a>
      <a class="cap nav__link nav__link--cta" href={mailto}>Write to us</a>
    </nav>
  </div>
  <div class="container"><hr class="rule" /></div>
</header>

<style>
  .nav__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-md);
    padding-block: var(--sp-md);
  }
  .nav__mark {
    display: flex;
    align-items: center;
    gap: var(--sp-2xs);
    color: var(--c-ink);
  }
  .nav__mark:hover { color: var(--c-ink); }
  .nav__word {
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--sp-md);
  }
  .nav__link { color: var(--c-ink); }
  .nav__link:not(.nav__link--cta) { display: none; }
  .nav__link--cta {
    border-bottom: var(--stroke-hair) solid var(--c-ochre);
    padding-bottom: 5px;
  }

  @media (min-width: 900px) {
    .nav__bar { padding-block: var(--sp-xl); }
    .nav__mark { gap: 15px; }
    .nav__word { font-size: 16px; letter-spacing: 0.18em; }
    .nav__links { gap: var(--sp-2xl); }
    .nav__link:not(.nav__link--cta) { display: inline; }
  }
</style>
