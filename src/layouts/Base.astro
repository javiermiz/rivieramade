---
import '../styles/global.css';
import { site, contact, pricing, deliversTo } from '../config';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  /** Set on pages that should not be indexed on their own. */
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  path = '/',
  noindex = false,
} = Astro.props;

const origin = (Astro.site ?? new URL(`https://${site.domain}`)).origin;
const canonical = new URL(path, origin).href;
const ogImage = new URL('/og.jpg', origin).href;

const prices = pricing.map((t) => t.price);

/**
 * One graph, two nodes: the studio and the thing it sells. Search engines and
 * the assistants that read them both want the price range and the area we
 * actually serve — the two questions every competitor leaves unanswered.
 */
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      '@id': `${origin}/#studio`,
      name: site.name,
      description: site.description,
      url: `${origin}/`,
      image: ogImage,
      email: contact.email,
      priceRange: `$${Math.min(...prices)}–$${Math.max(...prices)} USD`,
      currenciesAccepted: 'USD, MXN',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Puerto Morelos',
        addressRegion: 'Quintana Roo',
        addressCountry: 'MX',
      },
      areaServed: deliversTo.map((place) => ({
        '@type': 'City',
        name: place,
      })),
      knowsLanguage: ['en', 'es'],
    },
    {
      '@type': 'Product',
      '@id': `${origin}/#welcome-bag`,
      name: 'Wedding welcome bag',
      description:
        'A cotton tote printed with the couple’s names and date, holding a weekend card, two bottle labels and a luggage tag. Assembled in Puerto Morelos and delivered to the resort three days before the wedding.',
      image: ogImage,
      brand: { '@id': `${origin}/#studio` },
      offers: {
        '@type': 'AggregateOffer',
        priceCurrency: 'USD',
        lowPrice: Math.min(...prices),
        highPrice: Math.max(...prices),
        offerCount: prices.length,
        availability: 'https://schema.org/InStock',
        areaServed: deliversTo.join(', '),
        seller: { '@id': `${origin}/#studio` },
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="theme-color" content="#f6f3ec" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="631" />
    <meta property="og:image:alt" content="A printed cotton welcome tote on the sand in the Riviera Maya" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,400;0,500;1,400&family=Figtree:wght@400;500;600&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <slot />
  </body>
</html>
